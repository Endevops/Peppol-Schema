{
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "node:test",
    "effect/*",
    "better-auth/*",
    "#/index",
    "#/schema",
    "#/schematron",
    "#/values",
    "#/peppol-validations",
    "#/constants"
  ],
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "oxc.enable": true,
  "oxc.lint.run": "onSave",
  "oxc.requireConfig": true,
  "oxc.typeAware": true,
  "oxc.unusedDisableDirectives": "warn",
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "oxc.fixKind": "safe_fix_or_suggestion"
}

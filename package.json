{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "@endevops/peppol-schema",
  "version": "0.0.0",
  "private": false,
  "description": "A simple example library built by tsdown",
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.{spec,test}.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "development": "./src/constants/index.ts",
      "default": "./dist/constants.js"
    },
    "./schemas": {
      "development": "./src/schemas.ts",
      "default": "./dist/schemas.js"
    },
    "./schematron": {
      "development": "./src/schematron/index.ts",
      "default": "./dist/schematron.js"
    },
    "./validations": {
      "development": "./src/peppol-validations/index.ts",
      "default": "./dist/validations.js"
    },
    "./values": {
      "development": "./src/values.ts",
      "default": "./dist/values.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./constants": "./dist/constants.js",
      "./schemas": "./dist/schemas.js",
      "./schematron": "./dist/schematron.js",
      "./validations": "./dist/validations.js",
      "./values": "./dist/values.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "generate": "bun scripts/values.ts",
    "lint": "oxlint . --type-aware",
    "prepack": "tsdown",
    "prepare": "pnpm dlx husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "date-fns": "^4.4.0",
    "effect": "4.0.0-rc.110",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "testcontainers": "^12.1.0",
    "ts-extras": "^1.3.0",
    "tsdown": "^0.22.14",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@date-fns/tz": "^1",
    "date-fns": "^4",
    "effect": "4.0.0-rc.110",
    "fast-xml-builder": "^1",
    "fast-xml-parser": "^5",
    "zod": "^4"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --quiet --type-aware"
    ],
    "*.{xml,json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0",
  "inlinedDependencies": {
    "type-fest": "5.8.0"
  }
}

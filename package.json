{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "@endevops/peppol-schema",
  "version": "0.0.1",
  "description": "A simple example library built by tsdown",
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "TheYoxy",
      "url": "https://github.com/TheYoxy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/Peppol-Schema.git"
  },
  "bin": {
    "generate-translations": "./scripts/generate-translations.ts"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.{spec,test}.ts",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "development": "./src/constants/index.ts",
      "default": "./dist/constants.js"
    },
    "./generate-translations": {
      "development": "./scripts/generate-translations.ts",
      "default": "./dist/bin/generate-translations.mjs"
    },
    "./invoice-response-codes": {
      "development": "./src/invoice-response-codes/index.ts",
      "default": "./dist/invoice-response-codes.js"
    },
    "./schematron": {
      "development": "./src/schematron/index.ts",
      "default": "./dist/schematron.js"
    },
    "./validations": {
      "development": "./src/peppol-validations/index.ts",
      "default": "./dist/validations.js"
    },
    "./values": {
      "development": "./src/values.ts",
      "default": "./dist/values.js"
    },
    "./xml": {
      "development": "./src/xml.ts",
      "default": "./dist/xml.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "generate-translations": "./dist/bin/generate-translations.mjs"
    },
    "exports": {
      ".": "./dist/index.js",
      "./constants": "./dist/constants.js",
      "./generate-translations": "./dist/bin/generate-translations.mjs",
      "./invoice-response-codes": "./dist/invoice-response-codes.js",
      "./schematron": "./dist/schematron.js",
      "./validations": "./dist/validations.js",
      "./values": "./dist/values.js",
      "./xml": "./dist/xml.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "generate": "bun scripts/values.ts",
    "lint": "oxlint . --type-aware",
    "prepack": "tsdown",
    "prepare": "pnpm dlx husky && effect-tsgo patch --oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@effect/tsgo": "^0.45.0",
    "@effect/vitest": "^4.0.0-rc.113",
    "@nodable/compact-builder": "^2.0.0",
    "@nodable/flexible-xml-parser": "^1.11.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "effect": "^4.0.0-rc.113",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "picocolors": "^1.1.1",
    "publint": "^0.3.24",
    "semantic-release": "25.0.9",
    "simple-git": "^3.36.0",
    "testcontainers": "^12.1.0",
    "tsdown": "^0.23.0",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.113",
    "fast-xml-builder": "^1",
    "fast-xml-parser": "^5"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --quiet --type-aware"
    ],
    "*.{xml,json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.4.1",
  "inlinedDependencies": {
    "picocolors": "1.1.1"
  }
}

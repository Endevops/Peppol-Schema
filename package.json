{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
  "name": "@endevops/peppol-schema",
  "version": "0.0.1",
  "description": "TypeScript Effect Schema models for PEPPOL BIS Billing 3.0 — decode, validate and encode Invoice, Credit Note, Invoice Response and Message Level Response XML, with generated code lists, Schematron rules and identifier validations",
  "keywords": [
    "bis-billing",
    "credit-note",
    "e-invoicing",
    "e-procurement",
    "effect",
    "invoice",
    "openpeppol",
    "peppol",
    "peppol-bis",
    "schematron",
    "typescript",
    "ubl",
    "validation",
    "xml"
  ],
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "TheYoxy",
      "url": "https://github.com/TheYoxy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/Peppol-Schema.git"
  },
  "bin": {
    "generate-translations": "./scripts/generate-translations.ts"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.{spec,test}.ts",
    "NOTICE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*",
    "#/assets/*": "./assets/*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "development": "./src/constants/index.ts",
      "default": "./dist/constants.js"
    },
    "./generate-translations": {
      "development": "./scripts/generate-translations.ts",
      "default": "./dist/bin/generate-translations.mjs"
    },
    "./invoice-response-codes": {
      "development": "./src/invoice-response-codes/index.ts",
      "default": "./dist/invoice-response-codes.js"
    },
    "./schematron": {
      "development": "./src/schematron/index.ts",
      "default": "./dist/schematron.js"
    },
    "./validations": {
      "development": "./src/peppol-validations/index.ts",
      "default": "./dist/validations.js"
    },
    "./values": {
      "development": "./src/values.ts",
      "default": "./dist/values.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "generate-translations": "./dist/bin/generate-translations.mjs"
    },
    "exports": {
      ".": "./dist/index.js",
      "./constants": "./dist/constants.js",
      "./generate-translations": "./dist/bin/generate-translations.mjs",
      "./invoice-response-codes": "./dist/invoice-response-codes.js",
      "./schematron": "./dist/schematron.js",
      "./validations": "./dist/validations.js",
      "./values": "./dist/values.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "format": "vp fmt",
    "generate": "bun scripts/values.ts",
    "lint": "vp lint . --type-aware",
    "prepack": "vp pack",
    "prepare": "effect-tsgo patch --oxlint && vp config",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@effect/platform-node": "^4.0.0",
    "@effect/tsgo": "^0.46.1",
    "@effect/vitest": "^4.0.0",
    "@endevops/effect-codec-xml": "*",
    "@nodable/compact-builder": "^2.0.0",
    "@nodable/flexible-xml-parser": "^1.11.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "catalog:",
    "effect": "^4.0.0",
    "fallow": "^3.28.0",
    "picocolors": "^1.1.1",
    "publint": "^0.3.24",
    "semantic-release": "25.0.9",
    "simple-git": "^3.36.0",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.8.1",
  "inlinedDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "effect": "4.0.0",
    "picocolors": "1.1.1"
  }
}
